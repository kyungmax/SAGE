{
  "name": "main6_online24",
  "k": 10,
  "datasets": [
    "gooaq-distilroberta-768-normalized",
    "glove-100-angular",
    "cohere-768-angular",
    "youtube-15M-angular",
    "msmarco-qwen-1024-normalized",
    "msspacev-100M-i8-euclidean"
  ],
  "backends": [
    "faiss",
    "hnswlib"
  ],
  "prior_work_backends": [
    "faiss"
  ],
  "methods": {
    "faiss": [
      "vanilla",
      "sage_shadow128",
      "pip",
      "abs"
    ],
    "hnswlib": [
      "vanilla",
      "sage_shadow128"
    ]
  },
  "offline_threads": 24,
  "online_threads": 24,
  "warmups_per_setting": 1,
  "timed_repeats": 5,
  "index": {
    "default_M": 32,
    "default_efConstruction": 500,
    "reuse_existing_graphs": true,
    "same_faiss_graph_for_sage_vanilla_pip_abs": true
  },
  "calibration": {
    "internal_lid_k": 15,
    "lid_search_ef": 512,
    "lid_exclude_self": true,
    "probe_count": 500,
    "probe_source": "training/index only",
    "self_hidden": true,
    "pseudo_gt_ef": 4096,
    "probe_selection": "500 equal-count LID bins, midpoint per bin after 1-99% trim",
    "offline_min_ef": 64,
    "steps_per_doubling": 4,
    "initial_cap": 1024,
    "cap_increment": 1024,
    "high_ef_grid_step": 128,
    "offline_max_ef": 4096,
    "extend_when_recommendation_hits_cap": true,
    "epsilon": 0.001,
    "cfr_signal": "raw arithmetic mean",
    "classify_start": 1,
    "classify_end": 16,
    "main_buckets": 4,
    "main_margin": 2,
    "shadow_ef": 128,
    "shadow_margin": 4,
    "shadow_enabled_from_ef": 256,
    "shadow_routes": [
      32,
      64,
      96
    ],
    "recalibrate_on_current_backend": true,
    "offline_timing": {
      "Samp.": "node sampling and LID estimation",
      "Select.": "probe selection and self-hidden pseudo-ground-truth computation",
      "Eval.": "efSearch sweep and recommended-policy threshold fit",
      "curve_extra_seconds": "additional threshold fitting for the full online curve, reported separately"
    },
    "shadow_disabled_for_k": [
      100
    ]
  },
  "online": {
    "vanilla_full_curve": true,
    "sage_full_curve": true,
    "low_ef_extra": [
      16,
      24,
      32,
      48
    ],
    "initial_curve_cap": 2048,
    "always_include_recommendation": true,
    "extend_to_offline_cap": true,
    "baselines_target": "new FAISS SAGE exact total neighbor hits at its new recommended ef",
    "freeze_policies_before_test_data": true,
    "preserve_all_repeat_timings": true,
    "interleave_sage_vanilla": true,
    "baseline_final_context": "fresh process; chosen setting only; one warmup and five measured repeats",
    "comparison": "matched recall using exact integer neighbor hits"
  },
  "timing": {
    "metric": "whole query-batch search wall seconds",
    "same_scope_within_backend": true,
    "include_output_allocation": true,
    "include_query_preprocessing": true,
    "exclude_index_load": true,
    "exclude_calibration": true,
    "exclude_evaluation": true,
    "exclude_diagnostics": true,
    "shared_physical_cores": null,
    "numa_node": null,
    "cpus": null,
    "respect_smt_siblings": true,
    "one_timing_process_per_numa_node": true,
    "lock_file": "../timing.lock"
  },
  "cell_workers": {
    "faiss": "run_search_main6.py",
    "hnswlib": "run_search_main6.py",
    "pip": "run_baselines_main6.py",
    "abs": "run_baselines_main6.py"
  },
  "result_reuse": false,
  "run_order": [
    "faiss",
    "hnswlib",
    "pip",
    "abs"
  ],
  "output_creation": "New results under runs/01_main_results/k10 or runs/01_main_results/k100.",
  "baseline_tuning": {
    "target_schema": "config/main6_online24/targets_format.md",
    "selection_uses_evaluation_ground_truth": true,
    "global_optimum_claimed": false,
    "abs": {
      "gamma_resolution_denominator": 1000000,
      "initial_gamma_tick": 100000,
      "max_gamma_tick": 3200000,
      "local_radius_ticks": 4
    },
    "pip": {
      "threshold": 0.995,
      "local_radius_patience": 2,
      "selection_seed": 20260927
    }
  },
  "k_values": [
    10,
    100
  ],
  "exclude_datasets_by_k": {}
}
